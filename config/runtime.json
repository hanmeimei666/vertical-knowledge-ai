{
  "schema_version": 1,
  "domain": "sports_education",
  "knowledge_directory": "knowledge/shared",
  "raw_directory": "data/raw",
  "database": "data/workspaces/sports/catalog.sqlite3",
  "output_directory": "outputs/sports",
  "rules_file": "config/domain_rules.json",
  "reviewer": null,
  "retrieval": {
    "limit": 5,
    "minimum_score": 3
  },
  "model": {
    "backend": "extractive",
    "name": "",
    "endpoint": "http://127.0.0.1:11434/api/chat",
    "api_key_env": "OPENAI_API_KEY",
    "allow_external": false,
    "timeout_seconds": 60,
    "max_input_chars": 20000,
    "max_output_tokens": 1200
  },
  "service": {
    "host": "127.0.0.1",
    "port": 8765,
    "token_env": "VKA_SERVICE_TOKEN"
  },
  "workspace": {
    "id": "sports",
    "domains": [
      "conditioning",
      "football",
      "rehabilitation"
    ],
    "facets": [
      "population",
      "domain",
      "scenario",
      "goal",
      "media",
      "applicability"
    ]
  }
}