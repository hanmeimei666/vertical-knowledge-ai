{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeUnit",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "title",
    "content_type",
    "statement",
    "taxonomy_assignments",
    "applicability",
    "evidence_references",
    "review_state",
    "evidence_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "type": "string",
      "minLength": 1
    },
    "review_state": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "items": {}
    },
    "taxonomy_assignments": {
      "type": "array",
      "items": {}
    },
    "population_scope": {
      "type": "array",
      "items": {}
    },
    "domain_scope": {
      "type": "array",
      "items": {}
    },
    "scenario_scope": {
      "type": "array",
      "items": {}
    },
    "activity_scope": {
      "type": "array",
      "items": {}
    },
    "prerequisites": {
      "type": "array",
      "items": {}
    },
    "contraindications": {
      "type": "array",
      "items": {}
    },
    "safety_constraints": {
      "type": "array",
      "items": {}
    },
    "evidence_references": {
      "type": "array",
      "items": {}
    },
    "media_references": {
      "type": "array",
      "items": {}
    },
    "explanation": {
      "type": "string"
    },
    "applicability": {
      "type": "object"
    },
    "validity": {
      "type": "object"
    }
  }
}