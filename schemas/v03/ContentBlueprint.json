{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentBlueprint",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "goal",
    "population",
    "scenarios",
    "objectives",
    "units",
    "media_references",
    "interactions",
    "formats",
    "quality",
    "safety_constraints",
    "review_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "array",
      "items": {}
    },
    "scenarios": {
      "type": "array",
      "items": {}
    },
    "objectives": {
      "type": "array",
      "items": {}
    },
    "units": {
      "type": "array",
      "items": {}
    },
    "media_references": {
      "type": "array",
      "items": {}
    },
    "interactions": {
      "type": "array",
      "items": {}
    },
    "formats": {
      "type": "array",
      "items": {}
    },
    "quality": {
      "type": "object"
    },
    "safety_constraints": {
      "type": "array",
      "items": {}
    },
    "review_state": {
      "enum": [
        "draft",
        "review_pending"
      ]
    }
  }
}