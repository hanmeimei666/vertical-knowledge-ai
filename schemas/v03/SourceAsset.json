{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceAsset",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "title",
    "rights",
    "sensitivity",
    "file_path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "object"
    },
    "sensitivity": {
      "type": "string",
      "minLength": 1
    },
    "file_path": {
      "type": "string",
      "minLength": 1
    }
  }
}