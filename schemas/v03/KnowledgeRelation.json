{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeRelation",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "subject",
    "predicate",
    "object",
    "review_state",
    "evidence_references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "review_state": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {}
    }
  }
}