{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaxonomyDimension",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "label",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    }
  }
}