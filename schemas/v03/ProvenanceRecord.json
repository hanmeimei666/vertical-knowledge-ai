{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProvenanceRecord",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "entity",
    "activity",
    "agent",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "activity": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {}
    }
  }
}