{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "artifact_type",
    "source_blueprint",
    "source_assets",
    "generation_tools",
    "file_path",
    "file_hash",
    "review_state",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "source_blueprint": {
      "type": "string",
      "minLength": 1
    },
    "source_assets": {
      "type": "array",
      "items": {}
    },
    "generation_tools": {
      "type": "array",
      "items": {}
    },
    "file_path": {
      "type": "string",
      "minLength": 1
    },
    "file_hash": {
      "type": "string",
      "minLength": 1
    },
    "review_state": {
      "type": "string",
      "minLength": 1
    }
  }
}