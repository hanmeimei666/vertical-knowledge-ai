{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionRun",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "request",
    "steps",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "0.3"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object"
    },
    "steps": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "minLength": 1
    }
  }
}