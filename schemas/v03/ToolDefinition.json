    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "adapter_key": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "runtime_type": {
      "type": "string",
      "minLength": 1
    },
    "data_sensitivity": {
      "type": "string",
      "minLength": 1
    },
    "idempotency": {
      "type": "string",
      "minLength": 1
    },
    "health_check": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {}
    },
    "dependencies": {
      "type": "array",
      "items": {}
    },
    "permission_requirements": {
      "type": "array",
      "items": {}
    },
    "side_effects": {
      "type": "array",
      "items": {}
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "configuration_schema": {
      "type": "object"
    },
    "network_access": {
      "type": "boolean"
    },
    "external_processing": {
      "type": "boolean"
    },
    "deterministic": {
      "type": "boolean"
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "timeout": {
      "type": "number"
    }
