{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolDefinition",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "version",
    "tool_id",
    "name",
    "category",
    "description",
    "adapter_key",
    "status",
    "runtime_type",
    "data_sensitivity",
    "idempotency",
    "health_check",
    "capabilities",
    "dependencies",
    "permission_requirements",
    "side_effects",
    "input_schema",
    "output_schema",
    "configuration_schema",
    "network_access",
    "external_processing",
    "deterministic",
    "human_approval_required",
    "timeout"
